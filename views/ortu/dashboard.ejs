%><!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Info Keuangan <%= santri.nama %> — PPSZ NW Pasangkayu</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <div class="navbar">
    <div class="container">
      <a href="/ortu/dashboard" class="brand">👨‍👩‍👧 Info Keuangan Santri</a>
      <nav>
        <a href="/ortu/logout">Logout</a>
      </nav>
    </div>
  </div>

  <div class="container">
    <div class="card">
      <h1 class="card-title">Data Santri</h1>
      <table>
        <tr><th>Nama</th><td><%= santri.nama %></td></tr>
        <tr><th>Kelas</th><td><%= santri.kelas || '-' %></td></tr>
        <tr><th>Asrama</th><td><%= santri.asrama || '-' %></td></tr>
        <tr><th>Orang Tua / Wali</th><td><%= santri.nama_ortu || '-' %></td></tr>
      </table>
    </div>

    <div class="stats">
      <div class="stat green">
        <div class="label">Total Uang Masuk</div>
        <div class="value"><%= formatRupiah(totalMasuk) %></div>
      </div>
      <div class="stat red">
        <div class="label">Total Uang Keluar</div>
        <div class="value"><%= formatRupiah(totalKeluar) %></div>
      </div>
      <div class="stat yellow">
        <div class="label">Saldo Saat Ini</div>
        <div class="value"><%= formatRupiah(saldo) %></div>
      </div>
    </div>

    <div class="card">
      <h2 class="card-title">Riwayat Transaksi</h2>
      <% if (transaksi.length === 0) { %>
        <p class="muted">Belum ada transaksi untuk santri ini.</p>
      <% } else { %>
        <div class="table-responsive">
          <table>
            <thead>
              <tr>
                <th>Tanggal</th>
                <th>Jenis</th>
                <th>Kategori</th>
                <th>Keterangan</th>
                <th>Jumlah</th>
              </tr>
            </thead>
            <tbody>
              <% transaksi.forEach(function(t) { %>
                <tr>
                  <td><%= t.tanggal %></td>
                  <td>
                    <% if (t.jenis === 'masuk') { %>
                      <span class="badge badge-masuk">Masuk</span>
                    <% } else { %>
                      <span class="badge badge-keluar">Keluar</span>
                    <% } %>
                  </td>
                  <td><%= t.kategori || '-' %></td>
                  <td><%= t.keterangan || '-' %></td>
                  <td class="<%= t.jenis === 'masuk' ? 'amount-in' : 'amount-out' %>">
                    <%= (t.jenis === 'masuk' ? '+' : '-') %> <%= formatRupiah(t.jumlah) %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>

  <div class="footer">
    &copy; <%= new Date().getFullYear() %> PPSZ NW Pasangkayu — Sistem Informasi Keuangan Santri
  </div>
  <script src="/js/main.js"></script>
</body>
</html>
