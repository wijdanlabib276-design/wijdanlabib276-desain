<%- include('../partials/admin-header', { pageTitle: santri ? 'Edit Santri' : 'Tambah Santri' }) %>

  <h1><%= santri ? 'Edit Santri' : 'Tambah Santri' %></h1>
  <p class="muted"><a href="/admin/santri">← Kembali ke Data Santri</a></p>

  <% if (error) { %>
    <div class="alert alert-error"><%= error %></div>
  <% } %>

  <div class="card">
    <form method="POST" action="<%= santri ? '/admin/santri/' + santri.id + '/edit' : '/admin/santri/tambah' %>">
      <div class="form-group">
        <label for="nama">Nama Santri *</label>
        <input type="text" id="nama" name="nama" value="<%= santri ? santri.nama : '' %>" required />
      </div>
      <div class="form-group">
        <label for="kelas">Kelas</label>
        <input type="text" id="kelas" name="kelas" value="<%= santri ? santri.kelas : '' %>" />
      </div>
      <div class="form-group">
        <label for="asrama">Asrama</label>
        <input type="text" id="asrama" name="asrama" value="<%= santri ? santri.asrama : '' %>" />
      </div>
      <div class="form-group">
        <label for="nama_ortu">Nama Orang Tua / Wali</label>
        <input type="text" id="nama_ortu" name="nama_ortu" value="<%= santri ? santri.nama_ortu : '' %>" />
      </div>
      <div class="form-group">
        <label for="kontak_ortu">Kontak Orang Tua / Wali</label>
        <input type="text" id="kontak_ortu" name="kontak_ortu" value="<%= santri ? santri.kontak_ortu : '' %>" />
      </div>

      <% if (!santri) { %>
        <p class="muted">🔑 Kode akses akan dibuat otomatis setelah santri disimpan.</p>
      <% } %>

      <button type="submit" class="btn btn-primary"><%= santri ? 'Simpan Perubahan' : 'Simpan Santri' %></button>
      <a href="/admin/santri" class="btn btn-outline">Batal</a>
    </form>
  </div>

<%- include('../partials/footer') %>
