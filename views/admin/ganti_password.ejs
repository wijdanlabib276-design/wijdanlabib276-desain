<%- include('../partials/admin-header', { pageTitle: 'Ganti Password' }) %>

  <h1>Ganti Password</h1>
  <p class="muted">Perbarui password login admin Anda.</p>

  <% if (error) { %>
    <div class="alert alert-error"><%= error %></div>
  <% } %>

  <% if (success) { %>
    <div class="alert alert-success"><%= success %></div>
  <% } %>

  <div class="card">
    <form method="POST" action="/admin/ganti-password">
      <div class="form-group">
        <label for="password_lama">Password Lama *</label>
        <input type="password" id="password_lama" name="password_lama" required autofocus />
      </div>
      <div class="form-group">
        <label for="password_baru">Password Baru *</label>
        <input type="password" id="password_baru" name="password_baru" minlength="6" required />
        <small class="muted">Minimal 6 karakter.</small>
      </div>
      <div class="form-group">
        <label for="password_baru2">Konfirmasi Password Baru *</label>
        <input type="password" id="password_baru2" name="password_baru2" minlength="6" required />
      </div>
      <button type="submit" class="btn btn-primary">Simpan Password</button>
      <a href="/admin/dashboard" class="btn btn-outline">Batal</a>
    </form>
  </div>

<%- include('../partials/footer') %>
